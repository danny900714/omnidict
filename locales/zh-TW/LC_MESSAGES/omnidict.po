#: src/omnidict/editor.py:40
msgid "Click the next field to fetch definition."
msgstr "點擊下一個欄位以取得釋義。"

#: src/omnidict/editor.py:45
msgid "Please enter a word in the field above to proceed."
msgstr "請在上面的欄位輸入單字。"

#: src/omnidict/editor.py:59
#, python-brace-format
msgid "No definition found for \"{word}\""
msgstr "找不到「{word}」的釋義"

#: src/omnidict/editor.py:76
#, python-brace-format
msgid ""
"\"{word}\" wasn't found in \"{dictionary_name}\". Would you like to search "
"in \"{redirected_dictionary_name}\" instead?"
msgstr "無法在「{dictionary_name}」中找到「{word}」。是否改用「{redirected_dictionary_name}」中的釋義？"

#: src/omnidict/editor.py:97
#, python-brace-format
msgid ""
"\"{word}\" wasn't found. Would you like to use the definition for "
"\"{redirected_word}\" instead?"
msgstr "找不到「{word}」。是否改用「{redirected_word}」的釋義？"

#: src/omnidict/editor.py:108
#, python-brace-format
msgid ""
"Failed to parse the definition for \"{word}\". Please report this issue to "
"the developer.\n"
"{error}"
msgstr ""
"無法解析「{word}」的釋義。請將此問題回報給開發者。\n"
"{error}"

#: src/omnidict/editor.py:113
#, python-brace-format
msgid ""
"An unexpected error occurred:\n"
"{error}"
msgstr ""
"發生非預期的錯誤：\n"
"{error}"

#: src/omnidict/editor.py:143
msgid ""
"Will overwrite existing content in the current field. Do you want to proceed?"
msgstr "將會覆蓋掉目前欄位的內容。是否繼續？"
